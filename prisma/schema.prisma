generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS - Type-safe enumeration values
// ============================================================================

enum Role {
  ADMIN
  PROFESSOR
  STUDENT
  KIOSK
}

enum AuthProvider {
  EMAIL
  CWRU_SSO
}

enum CohortMemberStatus {
  INVITED
  JOINED
  ACTIVE
  COMPLETED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  ATTEMPT_START
  ATTEMPT_SUBMIT
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String?      // null for SSO users
  name          String?
  role          Role         @default(STUDENT)
  studentNumber String?
  authProvider  AuthProvider @default(EMAIL)
  
  // Account status
  isActive      Boolean      @default(true)
  emailVerified Boolean      @default(false)
  
  // Timestamps
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  lastLoginAt   DateTime?

  // Relationships
  sessions          Session[]
  cohortMemberships CohortMember[]
  assignments       CaseAssignment[]
  attempts          Attempt[]
  createdCohorts    Cohort[]         @relation("CohortCreator")
  createdCases      Case[]           @relation("CaseCreator")
  auditLogs         AuditLog[]
  interviewReports  InterviewReport[]
  scenarioReports   ScenarioReport[]

  @@index([email])
  @@index([role])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

// ============================================================================
// COHORT (Course Section)
// ============================================================================

model Cohort {
  id          String   @id @default(uuid())
  name        String
  code        String?  @unique
  description String?
  semester    String?
  year        Int?
  term        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Creator (professor)
  creatorId String?
  creator   User?   @relation("CohortCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  // Relationships
  members     CohortMember[]
  assignments CaseAssignment[]

  @@index([code])
  @@index([creatorId])
  @@index([isActive])
}

model CohortMember {
  id       String             @id @default(uuid())
  userId   String
  cohortId String
  status   CohortMemberStatus @default(JOINED)
  joinedAt DateTime           @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([userId, cohortId])
  @@index([userId])
  @@index([cohortId])
  @@index([status])
}

// ============================================================================
// CASE (Practice Scenario)
// ============================================================================

model Case {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  isPublished Boolean  @default(false)
  
  // Metadata
  difficulty     String?  // "beginner" | "intermediate" | "advanced"
  estimatedMins  Int?     // estimated time in minutes
  category       String?  // e.g., "negotiation", "conflict", "leadership"
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Creator
  createdById String?
  createdBy   User?   @relation("CaseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Relationships
  assignments CaseAssignment[]
  attempts    Attempt[]

  @@index([slug])
  @@index([isPublished])
  @@index([createdById])
}

// ============================================================================
// CASE ASSIGNMENT
// ============================================================================

model CaseAssignment {
  id         String   @id @default(uuid())
  userId     String
  caseId     String
  cohortId   String?
  assignedAt DateTime @default(now())
  
  // Optional: due date and max attempts
  dueAt       DateTime?
  maxAttempts Int?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  case   Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  cohort Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  @@unique([userId, caseId])
  @@index([userId])
  @@index([caseId])
  @@index([cohortId])
}

// ============================================================================
// ATTEMPT (Learning Record)
// ============================================================================

model Attempt {
  id                  String    @id @default(uuid())
  userId              String
  caseId              String
  attemptNumber       Int
  
  // Performance metrics
  score               Int?
  totalMessages       Int?
  totalTimeSeconds    Int?
  
  // Timestamps
  startedAt           DateTime  @default(now())
  submittedAt         DateTime?
  createdAt           DateTime  @default(now())
  
  // Evaluation
  evalResult          String?   @db.Text
  
  // Storage reference
  interactionLogS3Key String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([userId, caseId, attemptNumber])
  @@index([userId])
  @@index([caseId])
  @@index([submittedAt])
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entityType String?     // "User", "Cohort", "Case", "Attempt", etc.
  entityId   String?
  metadata   String?     @db.Text // JSON string for additional context
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================================
// INTERVIEW EVALUATION & REPORT
// ============================================================================
//
// Individual-ownership model: no cohortId, assignmentId, caseId, or
// attemptNumber. Interviews are unassigned practice sessions a student starts
// on their own; each run gets its own report row, unlimited repeats, no
// unique constraint. Do not model this on Attempt or CaseAssignment.

enum InterviewReportStatus {
  IN_PROGRESS
  PENDING
  READY
  FAILED
}

model InterviewReport {
  id                  String                @id @default(uuid())
  userId              String
  typeSlug            String
  interviewerAvatarId String?
  interviewerName     String?

  // Resume context snapshot — makes a report reproducible without re-parsing the PDF.
  // resumeText is a snapshot, NOT a pointer; the PDF itself is never exposed.
  resumeId            String?
  resumeText          String?               @db.Text

  // Canonical transcript lives in S3; this is the server-derived key.
  transcriptKey       String?
  turnCount           Int                   @default(0)

  status              InterviewReportStatus  @default(IN_PROGRESS)

  // Nullable by design. Visual and Vocal stay null until a real metrics pipeline exists.
  visualScore         Int?
  vocalScore          Int?
  contentScore        Int?
  behavioralScore     Int?

  reportMarkdown      String?               @db.Text
  failureReason       String?               @db.Text
  evalModel           String?

  // Resolved customization snapshot — what this session actually ran with, not the
  // preset's defaults. Nullable: rows written before Phase 8 have none.
  industry            String?
  roleTitle           String?
  difficulty          String?
  targetMinutes       Int?
  targetQuestionCount Int?
  interviewerPersona  String?               @db.Text

  startedAt           DateTime              @default(now())
  completedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, typeSlug])
}

model ScenarioReport {
  id                 String                @id @default(uuid())
  userId             String

  // The S3 CaseStudy id this run played. Deliberately a bare String and NOT a
  // Prisma relation — the scenario lives in S3, not Postgres, and REQ-34 requires
  // this report to survive that scenario's deletion. There is nothing to cascade.
  caseId             String

  // Pointer back to the S3 InteractionLog this run produced, so the evaluator can
  // re-read the transcript without a second copy being written.
  // interactions/{studentEmail}/{caseId}/{logId}.json
  interactionLogId   String?
  studentEmail       String?

  status             InterviewReportStatus @default(IN_PROGRESS)

  turnCount          Int                   @default(0)

  // Nullable by design. Visual and Vocal stay null until Phase 10 builds a real
  // video/audio metrics pipeline. Enforced in code, never trusted from the model.
  visualScore        Int?
  vocalScore         Int?
  contentScore       Int?
  behavioralScore    Int?

  reportMarkdown     String?               @db.Text
  failureReason      String?               @db.Text
  evalModel          String?

  // REQ-33 run-time snapshot. Written once when the run is recorded; never updated
  // when the underlying scenario is later edited or deleted.
  caseName           String
  backgroundSnapshot String                @db.Text
  avatarsSnapshot    Json
  criteriaSnapshot   String?               @db.Text

  startedAt          DateTime              @default(now())
  completedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, caseId])
}
