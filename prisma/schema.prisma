generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS - Type-safe enumeration values
// ============================================================================

enum Role {
  ADMIN
  PROFESSOR
  STUDENT
  KIOSK
}

enum AuthProvider {
  EMAIL
  CWRU_SSO
}

enum CohortMemberStatus {
  INVITED
  JOINED
  ACTIVE
  COMPLETED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  ATTEMPT_START
  ATTEMPT_SUBMIT
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String? // null for SSO users
  name          String?
  role          Role         @default(STUDENT)
  studentNumber String?
  authProvider  AuthProvider @default(EMAIL)

  // Account status
  isActive      Boolean @default(true)
  emailVerified Boolean @default(false)

  // REQ-36: account-level acceptance of video/audio analysis, remembered across
  // sessions. Distinct from the browser permission dialog, which is not consent
  // to being ANALYSED. Each report row snapshots this at session start.
  videoAnalysisConsentAt DateTime?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relationships
  sessions               Session[]
  cohortMemberships      CohortMember[]
  assignments            CaseAssignment[]
  attempts               Attempt[]
  createdCohorts         Cohort[]                @relation("CohortCreator")
  createdCases           Case[]                  @relation("CaseCreator")
  auditLogs              AuditLog[]
  interactionReports     InteractionReport[]
  studyPlans             StudyPlan[]
  networkingAttestations NetworkingAttestation[]
  authHandoffs           AuthHandoff[]
  masteryContributions   MasteryContribution[]
  knowledgeChecks        KnowledgeCheck[]
  knowledgeCheckAttempts KnowledgeCheckAttempt[]
  gradingContests        GradingContest[]
  studyPlanPaths         StudyPlanPath[]
  coachedSessions        CoachedSession[]
  momentCompetencyScores MomentCompetencyScore[]

  /// Chosen once in Settings; null means the default coach.
  coachAvatarId String?
  coachVoiceId  String?
  coachName     String?

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// A short-lived, single-use bridge from the fixed production CAS callback to
// the deployment (usually a Vercel preview) that initiated login. Raw state and
// code values never reach the database: only SHA-256 hashes are stored here.
model AuthHandoff {
  id               String    @id @default(uuid())
  stateHash        String    @unique
  codeHash         String?   @unique
  browserNonceHash String?
  userId           String?
  targetOrigin     String
  targetPath       String
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([token])
}

// ============================================================================
// COHORT (Course Section)
// ============================================================================

model Cohort {
  id          String   @id @default(uuid())
  name        String
  code        String?  @unique
  description String?
  semester    String?
  year        Int?
  term        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Creator (professor)
  creatorId String?
  creator   User?   @relation("CohortCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  // Relationships
  members     CohortMember[]
  assignments CaseAssignment[]

  @@index([code])
  @@index([creatorId])
  @@index([isActive])
}

model CohortMember {
  id       String             @id @default(uuid())
  userId   String
  cohortId String
  status   CohortMemberStatus @default(JOINED)
  joinedAt DateTime           @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([userId, cohortId])
  @@index([userId])
  @@index([cohortId])
  @@index([status])
}

// ============================================================================
// CASE (Practice Scenario)
// ============================================================================

model Case {
  id          String  @id @default(uuid())
  slug        String  @unique
  title       String
  description String?
  isPublished Boolean @default(false)

  // Metadata
  difficulty    String? // "beginner" | "intermediate" | "advanced"
  estimatedMins Int? // estimated time in minutes
  category      String? // e.g., "negotiation", "conflict", "leadership"

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Creator
  createdById String?
  createdBy   User?   @relation("CaseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Relationships
  assignments CaseAssignment[]
  attempts    Attempt[]

  @@index([slug])
  @@index([isPublished])
  @@index([createdById])
}

// ============================================================================
// CASE ASSIGNMENT
// ============================================================================

model CaseAssignment {
  id         String   @id @default(uuid())
  userId     String
  caseId     String
  cohortId   String?
  assignedAt DateTime @default(now())

  // Optional: due date and max attempts
  dueAt       DateTime?
  maxAttempts Int?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  case   Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  cohort Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  @@unique([userId, caseId])
  @@index([userId])
  @@index([caseId])
  @@index([cohortId])
}

// ============================================================================
// ATTEMPT (Learning Record)
// ============================================================================

model Attempt {
  id            String @id @default(uuid())
  userId        String
  caseId        String
  attemptNumber Int

  // Performance metrics
  score            Int?
  totalMessages    Int?
  totalTimeSeconds Int?

  // Timestamps
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  // Evaluation
  evalResult String? @db.Text

  // Storage reference
  interactionLogS3Key String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([userId, caseId, attemptNumber])
  @@index([userId])
  @@index([caseId])
  @@index([submittedAt])
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entityType String? // "User", "Cohort", "Case", "Attempt", etc.
  entityId   String?
  metadata   String?     @db.Text // JSON string for additional context
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================================
// INTERVIEW EVALUATION & REPORT
// ============================================================================
//
// Individual-ownership model: no cohortId, assignmentId, caseId, or
// attemptNumber. Interviews are unassigned practice sessions a student starts
// on their own; each run gets its own report row, unlimited repeats, no
// unique constraint. Do not model this on Attempt or CaseAssignment.

enum InterviewReportStatus {
  IN_PROGRESS
  PENDING
  READY
  FAILED
}

// `InterviewReport` and `ScenarioReport` models were removed in plan 13-15
// (DROP TABLE migration). Their data lives in `InteractionReport` after backfill.
// `enum InterviewReportStatus` is retained — name is historical (shared by both
// legacy tables and the unified model).

// ============================================================================
// INTERACTION REPORT (Phase 13 unified report — REQ-65)
// ============================================================================
//
// Unified report table for every interaction type. Legacy `InterviewReport`
// and `ScenarioReport` tables were dropped in plan 13-15 after the 13-04
// backfill. Shared-DB DROP remains a human-run, declinable handoff (REQ-67).
//
// `typeSlug` carries the engine type ("general" | "technical" | "consulting"
// | "early-career" | "case-study", and later Phase 14-16 additions) so one
// table serves every interaction type without a migration per type.
// `inputSnapshot` and `scores` are JSON precisely so a new type or a new
// rubric dimension needs zero columns and zero migration — see
// `lib/report/snapshot.ts` for their TypeScript shapes.

model InteractionReport {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Engine type slug: "general" | "technical" | "consulting" |
  // "early-career" | "case-study", extended by Phases 14-16.
  typeSlug String

  // Name is historical: this enum was already shared by `InterviewReport`
  // and `ScenarioReport` before this model existed. Renaming it here would
  // touch every importer of the existing enum for no behavioral gain, so
  // Phase 13 deliberately keeps the name `InterviewReportStatus`.
  status InterviewReportStatus @default(IN_PROGRESS)

  // Per-type input, typed in TypeScript (see `lib/report/snapshot.ts`
  // `InputSnapshot`), discriminated on `kind`. Nullable so an IN_PROGRESS
  // row can exist before the snapshot is complete — matching today's
  // behavior where snapshot columns are written at session start.
  inputSnapshot Json?

  // Dimension-keyed score map, e.g. {visual, vocal, content, behavioral,
  // deck_quality}. A new rubric dimension needs no migration.
  scores Json?

  // Three separate nullable pointers, deliberately NOT converged into one
  // tagged-union pointer (discretion item, decided here): `transcriptKey`
  // (interview) and `interactionLogId` (scenario) resolve through different
  // S3Storage accessors with different required context —
  // `getInterviewTranscript(userId, reportId)` vs
  // `getInteractionLog(studentEmail, caseId, logId)` — so converging them
  // would buy a tagged union and cost read-path branching for no
  // requirement. `studentEmail` is retained precisely because the scenario
  // S3 read cannot resolve without it.
  transcriptKey    String?
  interactionLogId String?
  studentEmail     String?

  turnCount Int @default(0)

  // Phase 10 video/audio metrics. All nullable: a row written before
  // Phase 10 has every field null, which is exactly the "Not yet measured"
  // legacy state. Only DERIVED NUMBERS are stored here — never media
  // (REQ-38). `cameraMode === null` means "pre-Phase-10 row, do not
  // synthesize an unscored reason" (REQ-48) — nothing may coerce null to
  // "OFF".
  cameraMode           String? // "ON" | "OFF"; null = pre-Phase-10 row
  visualMetrics        Json?
  vocalMetrics         Json?
  visualUnscoredReason String? // "CAMERA_OFF_OPTOUT" | "INSUFFICIENT_DATA"
  vocalUnscoredReason  String? // "TYPED_ONLY" | "SPEECH_TOO_SHORT" | "INSUFFICIENT_DATA"
  metricsConsentAt     DateTime? // snapshot of the account-level consent in force for this run

  /// Structured report body — see `lib/report/structured.ts`. Null on every
  /// row written before the evaluator returned structured output; those
  /// rows still render from `reportMarkdown`, which is now COMPOSED from
  /// this rather than returned by the model.
  reportStructured Json?
  reportMarkdown   String? @db.Text
  failureReason    String? @db.Text
  evalModel        String?

  // REQ-62: the recorded reason an avatar-initiated end produces. Nullable;
  // null means the session ended normally (student- or system-initiated).
  terminationReason String?

  // REQ-64: the type-declared outcome record (e.g. negotiated price and
  // equity). Nullable; shape is per-type and enforced in code only.
  outcome Json?

  // Zero-based index of the highest slide ever revealed to the avatar.
  // SERVER-WRITTEN ONLY, monotonic non-decreasing. Null for every type that
  // has no deck AND for a deck session that has not revealed anything yet
  // (null means "nothing revealed" — never persist -1). A client never writes
  // this value directly — see lib/engine/session.ts's ratchet. Backward
  // navigation never lowers it (Phase 14 CONTEXT.md: the investor already
  // saw those slides).
  slideHighWaterMark Int?

  // Ordered append-only trail of
  // `{ index, atTurnIndex, atElapsedSeconds }` reveal events. Feeds
  // Criterion 4's slide/speech correlation scoring and the report's
  // timeline. Append-only: entries are never rewritten or removed.
  slideReveals Json?

  // The session's resolved time budget in seconds, after the student's
  // adjustment was clamped into the type's declared adjustableRangeSeconds.
  // Null for types with no budget. The budget is SOFT: nothing in the app
  // stops a session when it is exhausted; the overrun is noted in the report.
  timeBudgetSeconds Int?

  // Elapsed seconds at the moment an avatar-initiated end was ACCEPTED, so
  // the report can show the timecode where interest dropped (Phase 14
  // CONTEXT.md). Null when the session ended normally. Pairs with the
  // existing terminationReason column.
  terminationAtSeconds Int?

  // Student-chosen display name for My Reports (nullable for pre-title rows).
  // Finish writes a default when the student leaves it blank.
  title String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([userId, typeSlug])
}

// ============================================================================
// STUDY PLANS
// ============================================================================
//
// Saved plans are immutable, student-owned snapshots synthesized from multiple
// completed interview reports. A generated preview is deliberately not stored;
// a row exists only after the student explicitly saves it.

model StudyPlan {
  id                String   @id @default(uuid())
  userId            String
  title             String
  content           Json
  sourceReportIds   Json
  sourceReportCount Int
  generationModel   String
  draftTokenId      String   @unique
  savedAt           DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  path            StudyPlanPath?
  knowledgeChecks KnowledgeCheck[]

  @@index([userId, savedAt])
}

// ============================================================================
// NETWORKING ATTESTATION (Phase 16)
// ============================================================================

/// 16-CONTEXT.md decision 8: an attestation recorded before third-party pasted text
/// is accepted for persona distillation. Deliberately NOT modelled as a column on
/// `User` like `videoAnalysisConsentAt`: decision 8 rejects "a once-per-student
/// acknowledgement that later sessions skip", so this is one row per distillation
/// event, single-use via `consumedAt`.
///
/// APPEND-ONLY. `consumedAt` is the only column that is ever updated. Rows are never
/// deleted and `wordingVersion` is never rewritten — the audit trail depends on it.
model NetworkingAttestation {
  id             String    @id @default(uuid())
  userId         String
  attestedAt     DateTime  @default(now())
  /// The version key of the exact wording the student was shown, from
  /// NETWORKING_ATTESTATION_WORDING in lib/networking/attestation.ts. Phase 10's
  /// consent record has no equivalent field; this is genuinely new.
  wordingVersion String
  /// Stamped when this attestation is spent on one distillation. Non-null means spent.
  consumedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, attestedAt])
  @@index([userId, consumedAt])
}

// ============================================================================
// ADAPTIVE MASTERY PATH (Phase 21)
// ============================================================================
//
// 21-CONTEXT.md's two structural decisions, encoded here:
// - A path is a CHILD of StudyPlan ("not a global queue") — StudyPlanPath has
//   a @unique, Cascade relation to its plan. There is no active flag and no
//   delete; old paths remain reachable only through the plan that owns them.
// - Every mastery contribution, whatever its source, is ONE row in ONE ledger
//   (MasteryContribution) — both live sessions and knowledge checks move
//   mastery, and nothing else writes a mastery-affecting row outside it.

/// REQ-107's single ledger. Every event that moves a student's mastery figure —
/// a live session, a coached session, or a graded knowledge-check attempt —
/// writes exactly one row here. APPEND-ONLY apart from `reversedAt` /
/// `reversedReason`: REQ-112's contest reverses a contribution in place rather
/// than deleting the row, so the ledger always shows what happened and why it
/// no longer counts.
model MasteryContribution {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The competency this contribution counts toward. Derived from existing
  /// rubric dimensions (21-CONTEXT.md), not a fixed enum.
  competencyKey String

  /// "LIVE_SESSION" | "COACHED_SESSION" | "CHECK_DETERMINISTIC" |
  /// "CHECK_MODEL_GRADED". Enforced in application code, not a Prisma enum —
  /// a later source needs no migration.
  source String

  /// Normalized 0..1 score this event produced.
  rawScore Float

  /// The declared weight in force when this row was written, SNAPSHOTTED at
  /// write time rather than looked up at read time. Retuning weights later
  /// never silently rewrites history.
  weight Float

  /// Soft, relation-free pointer to the InteractionReport for a live or
  /// coached session. Null for a knowledge-check contribution.
  sourceReportId String?

  /// KnowledgeCheckAttempt id for a check-sourced contribution. Null otherwise.
  sourceAttemptId String?

  /// Set for COACHED_SESSION rows written from Phase 22 on; coached sessions no
  /// longer produce an InteractionReport.
  sourceCoachedSessionId String?

  /// Non-null means a GradingContest reversed this contribution; it no longer
  /// counts toward mastery but the row is never deleted.
  reversedAt     DateTime?
  reversedReason String?

  /// The session's or attempt's own time, NOT createdAt. REQ-104's
  /// current-window figure windows on this, not on when the row was written.
  occurredAt DateTime

  createdAt DateTime @default(now())

  @@index([userId, competencyKey, occurredAt])
  @@index([userId, occurredAt])
  @@index([sourceAttemptId])
  @@index([sourceCoachedSessionId])
}

/// One generated question, in any of the four formats all four formats ship
/// (21-CONTEXT.md). Lives inside the study-plan surface as a path step; never
/// a registered engine interaction type.
model KnowledgeCheck {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A check belongs to the plan whose path generated it.
  studyPlanId String
  studyPlan   StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  competencyKey String

  /// "MULTIPLE_CHOICE" | "FILL_IN_BLANK" | "PICK_BETTER_RESPONSE" |
  /// "REWRITE_WEAK_LINE".
  format String

  prompt String @db.Text

  /// Format-specific body — options, blanks, the two candidate responses, the
  /// weak line. Shape validated in TypeScript per format; see
  /// lib/study-plan/checks/types.ts.
  payload Json

  /// Null for REWRITE_WEAK_LINE, which has no deterministic key — that
  /// nullability is what makes REQ-111's split visible in the schema.
  answerKey Json?

  /// REQ-110: the verbatim quote and its originating turn, stored so the
  /// never-misquote guarantee is re-checkable after the fact, not only at
  /// generation time.
  sourceReportId  String?
  quotedTurnIndex Int?
  quotedText      String? @db.Text

  generationModel String

  /// REQ-112: a student flags a bad generated question.
  flaggedAt  DateTime?
  flagReason String?

  createdAt DateTime @default(now())

  attempts KnowledgeCheckAttempt[]

  @@index([userId, studyPlanId])
  @@index([userId, competencyKey])
  @@index([flaggedAt])
}

/// One student answer to a KnowledgeCheck.
model KnowledgeCheckAttempt {
  id String @id @default(uuid())

  knowledgeCheckId String
  knowledgeCheck   KnowledgeCheck @relation(fields: [knowledgeCheckId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  response Json

  /// Null while a model grading is pending.
  correct Boolean?
  score   Float?

  /// "DETERMINISTIC" | "MODEL".
  gradedBy        String
  graderModel     String?
  graderRationale String? @db.Text

  submittedAt DateTime  @default(now())
  gradedAt    DateTime?

  contest GradingContest?

  /// One attempt per check per student; a re-answer after a contest is
  /// handled by the contest row, not by a second attempt.
  @@unique([knowledgeCheckId, userId])
  @@index([userId, submittedAt])
}

/// REQ-112: a student contests a grading, which also surfaces bad generated
/// questions instead of letting them quietly damage mastery.
model GradingContest {
  id String @id @default(uuid())

  attemptId String                @unique
  attempt   KnowledgeCheckAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reason String @db.Text

  /// "OPEN" | "UPHELD" | "REJECTED".
  status String @default("OPEN")

  raisedAt       DateTime  @default(now())
  resolvedAt     DateTime?
  resolutionNote String?   @db.Text

  @@index([status, raisedAt])
}

/// REQ-117: a path is a CHILD of StudyPlan, not a global queue. `@unique` on
/// studyPlanId makes it exactly one path per plan; `onDelete: Cascade` makes
/// it a child rather than a peer. Old paths are NOT deleted and NOT carried
/// forward when a new study plan generates a new path — they remain
/// reachable only through the StudyPlan that owns them. Nothing in this
/// schema expires a path.
model StudyPlanPath {
  id String @id @default(uuid())

  studyPlanId String    @unique
  studyPlan   StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  generatedAt DateTime @default(now())

  /// The mastery figures the path was generated against, frozen at
  /// generation time. REQ-118's explanation must still make sense months
  /// later, after mastery has moved on.
  selectionSnapshot Json

  createdAt DateTime @default(now())

  steps StudyPlanPathStep[]

  @@index([userId, generatedAt])
}

/// 5 to 10 per path (21-CONTEXT.md). The bound is enforced in code
/// (lib/study-plan/path.ts), NOT in SQL — nothing here guards it at the
/// database level.
model StudyPlanPathStep {
  id String @id @default(uuid())

  pathId String
  path   StudyPlanPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  position Int

  /// "KNOWLEDGE_CHECK" | "COACHED_SESSION" | "UNAIDED_SESSION".
  kind String

  competencyKey String

  /// REQ-118: stored, not recomputed, so the student is shown the reason
  /// that actually drove selection.
  selectionReason String @db.Text

  knowledgeCheckId String?
  coachedSessionId String?

  /// "PENDING" | "COMPLETE" | "SKIPPED".
  status String @default("PENDING")

  completedAt DateTime?

  coachedSession CoachedSession?

  @@unique([pathId, position])
}

/// REQ-113/114. A coached session exists ONLY as a path step —
/// `pathStepId @unique` with `onDelete: Cascade` is the schema-level half of
/// "reachable only through a path". Replay-first is not optional, so the
/// replay fields are non-null: the coach sets up the actual moment from the
/// student's transcript, then presents a fresh situation exercising the same
/// competency.
model CoachedSession {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pathStepId String            @unique
  pathStep   StudyPlanPathStep @relation(fields: [pathStepId], references: [id], onDelete: Cascade)

  competencyKey String

  replaySourceReportId String
  replayTurnIndex      Int

  /// Pre-Phase-22 rows only; the fresh leg is now a second real moment, see
  /// freshSourceReportId/freshTurnIndex.
  freshScenarioPrompt String? @db.Text

  /// Second real moment for the FRESH leg. Both null means thin evidence (a
  /// one-leg session); both set otherwise.
  freshSourceReportId String?
  freshTurnIndex      Int?

  /// "PER_TURN_SCORE" | "GROWTH_AREA_FALLBACK". Null marks a pre-Phase-22 row.
  selectionBasis String?

  /// Set when the REPLAY leg closes.
  replayLegCompletedAt DateTime?

  /// The per-turn score (1..5) each moment was selected with; null under the
  /// growth-area fallback. Lets the brief and the coach frame a moment scored
  /// above MAX_REWORKABLE_SCORE as refinement.
  replayMomentScore Int?
  freshMomentScore  Int?

  /// Pre-Phase-22 rows only. Coached sessions no longer produce an
  /// InteractionReport.
  reportId String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  turns CoachedTurn[]

  @@index([userId, startedAt])
}

/// One utterance in a coached session's per-leg conversation: a coach move or
/// a student reply/attempt. Discriminators are plain Strings, enforced in
/// application code.
model CoachedTurn {
  id String @id @default(uuid())

  coachedSessionId String
  coachedSession   CoachedSession @relation(fields: [coachedSessionId], references: [id], onDelete: Cascade)

  /// "REPLAY" | "FRESH"
  leg String
  seq Int

  /// "COACH" | "STUDENT"
  speaker String

  /// Coach: OPEN | ASK_DIAGNOSIS | CONFIRM | CORRECT | INVITE_ATTEMPT |
  /// DEMONSTRATE | LEG_DONE. Student: REPLY | ATTEMPT.
  move String

  /// Coach rows: "REPLY" | "ATTEMPT" | "NONE".
  awaiting String?

  text          String  @db.Text
  demonstration String? @db.Text

  /// Grade of a student ATTEMPT row.
  score          Int?
  acceptable     Boolean?
  parroted       Boolean?
  gradeRationale String?  @db.Text

  spokenDurationMs Int?
  closedAtSoftCap  Boolean?

  createdAt DateTime @default(now())

  @@unique([coachedSessionId, seq])
  @@index([coachedSessionId, leg])
}

/// Cache of per-turn competency scores for 22-07's scorer, so the same moment
/// is never re-scored. Soft pointer to InteractionReport, no FK (same
/// convention as MasteryContribution.sourceReportId).
model MomentCompetencyScore {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reportId      String
  turnIndex     Int
  competencyKey String

  evidencesCompetency Boolean
  /// 1..5; null when the turn does not evidence the competency.
  score               Int?
  rationale           String  @db.Text
  model               String

  createdAt DateTime @default(now())

  @@unique([reportId, turnIndex, competencyKey])
  @@index([userId])
}
