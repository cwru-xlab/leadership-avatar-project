# Environment variable template.
# Copy to .env.local (and keep DATABASE_URL in sync with .env for Prisma).
# See also .env.template — that file is what `npm run setup` references.

AWS_ACCESS_KEY_ID=
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_SECRET_ACCESS_KEY=
EDGE_CONFIG=
HEYGEN_API_KEY=
# Optional: LiveAvatar persona context UUID (defaults are set in code if unset)
HEYGEN_AVATAR_CONTEXT_ID=
JWT_SECRET=
# Exact registered production CAS callback, e.g. https://avatar.example.edu/api/auth/cwru-sso-callback.
# This must be set in Vercel Production and Preview; previews always broker through it.
CWRU_CAS_CALLBACK_URL=
# Vercel deployment hostname prefix allowed to receive a preview handoff, e.g. leadership-avatar-project-.
CWRU_ALLOWED_PREVIEW_HOST_PREFIX=
# High-entropy server-only secret shared by this app's Vercel Production and Preview environments.
# It signs five-minute preview-to-production initiation assertions; never expose it as NEXT_PUBLIC_*.
AUTH_HANDOFF_SECRET=
# Secret for short-lived, server-signed study-plan preview tokens.
STUDY_PLAN_DRAFT_SECRET=
NEXT_PUBLIC_LIVEAVATAR_API_URL=https://api.liveavatar.com
OPENAI_API_KEY=
VERCEL_OIDC_TOKEN=
PINECONE_API_KEY=
PINECONE_REGION=
PINECONE_INDEX_NAME=
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DATABASE_URL=

# --- Deck conversion (decided in Phase 14 plan 14-01) ---
# Backend that turns PPTX into PDF before per-page PNG rasterization.
# Selected: gotenberg (self-hosted on AWS Lightsail). Fallbacks if needed:
# vercel-libreoffice | cloudconvert — see 14-DECK-RENDER-DECISION.md
DECK_CONVERT_BACKEND=gotenberg
# Base URL of the Gotenberg host (human must provision; no trailing slash required).
DECK_CONVERT_URL=
# Shared secret sent as Authorization: Bearer … (human supplies; do not commit secrets).
DECK_CONVERT_TOKEN=
